{
  "hooks": {},
  "permissions": {
    "deny": [
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*secret*.conf)",
      "Read(**/*credential*.conf)",
      "Read(//etc/**/*.conf)",
      "Read(**/*.config)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.development)",
      "Read(.env.production)",
      "Read(.env.staging)",
      "Read(.env.test)"
    ]
  }
}
